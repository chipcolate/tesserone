---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import FeatureList from "../components/FeatureList.astro";
import Showcase from "../components/Showcase.astro";
import Backstory from "../components/Backstory.astro";
import OSSection from "../components/OSSection.astro";
import More from "../components/More.astro";
import Footer from "../components/Footer.astro";

const lang = "en" as const;
---

<Layout lang={lang}>
  <Header lang={lang} />
  <main class="min-w-0 overflow-x-clip">
    <Hero lang={lang} />
    <FeatureList lang={lang} />
    <Showcase lang={lang} />
    <Backstory lang={lang} />
    <OSSection lang={lang} />
    <More lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
